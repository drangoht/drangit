@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResources> T
@inject NavigationManager Navigation

@* Ni en-tête ni pied : la page est la fenêtre de terminal, et rien ne l'encadre (ADR 0010).
   Ce que le bandeau portait est reparti où il sert — le sélecteur de langue dans la barre de
   titre de la fenêtre, la navigation dans les commandes « cd » et les fils d'Ariane. *@

@* Le lien d'évitement reste : il est invisible jusqu'à ce qu'on l'atteigne au clavier, et
   l'adresse courante y est répétée en entier — avec <base>, un « #main » nu se résoudrait
   contre la base et ferait quitter la page. *@
<a class="skip-link" href="@CurrentPath#main">@T["Nav.SkipToContent"]</a>

<main id="main" class="shell site-main">
    @Body
</main>

@code {
    /// <summary>Adresse de la page courante, préfixe de langue et critères compris.</summary>
    private string CurrentPath => new Uri(Navigation.Uri).PathAndQuery;
}
