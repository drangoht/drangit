@inject IStringLocalizer<SharedResources> T

@* Une ligne de sortie, et non une tuile : quarante-sept dépôts se lisent en colonnes
   alignées (ADR 0008). L'ordre des colonnes reprend celui d'un « ls -l » — ce qui classe
   d'abord, ce qui identifie ensuite. *@
<li class="listing__item @(Repository.IsArchived ? "listing__item--archived" : null)">
    <a class="listing__link" href="repos/@Repository.Slug.Value">
        <span class="listing__language" style="--cover-ink: @RepositoryVisual.InkOf(Repository.Language)">
            @Repository.Language
        </span>

        <span class="listing__date">
            @if (Repository.PushedAt is { } pushedAt)
            {
                @* <time> et non du texte : la date affichée suit la culture du visiteur, la
                   date lisible par une machine reste ISO-8601. *@
                <time datetime="@pushedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                    @pushedAt.ToString("d", CultureInfo.CurrentCulture)
                </time>
            }
        </span>

        <span class="listing__stars" title="@T["Repo.Stars"]">
            @(Repository.Stars > 0 ? "★ " + Repository.Stars.ToString("N0", CultureInfo.CurrentCulture) : null)
        </span>

        <span class="listing__name">
            <span class="listing__owner">@Owner</span>@Repository.Name
        </span>

        <span class="listing__description">
            @if (Description is { } description)
            {
                @description
            }
        </span>
    </a>

    <RepositoryBadges Repository="Repository" />
</li>

@code {
    /// <summary>Dépôt présenté par la ligne.</summary>
    [Parameter, EditorRequired]
    public required Repository Repository { get; set; }

    private string? Description => Repository.Description.For(CultureInfo.CurrentUICulture);

    /// <summary>Compte propriétaire, barre oblique comprise.</summary>
    private string Owner =>
        Repository.FullName.LastIndexOf('/') is var separateur && separateur > 0
            ? Repository.FullName[..(separateur + 1)]
            : string.Empty;
}
