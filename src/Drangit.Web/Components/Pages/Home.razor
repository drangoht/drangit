@page "/"
@using Microsoft.AspNetCore.WebUtilities
@inject IRepositoryCatalog Catalog
@inject IStringLocalizer<SharedResources> T
@inject IOptions<SiteOptions> Site
@inject NavigationManager Navigation

<PageTitle>@Site.Value.Name</PageTitle>
@* Pas d'ImageUrl : l'accueil représente le site, pas le dépôt qui passe en vitrine.
   SeoHead pose donc l'image du site. *@
<SeoHead CanonicalPath="/"
         Title="@Site.Value.Name"
         Description="@T["Home.Intro"]" />

@* Toute la page tient dans un seul cadre : barre de titre, écran, prompt. Il n'y a plus de
   barre de critères ni de vitrine au-dessus de la liste — tout passe par le prompt
   (ADR 0010). *@
<div class="window">
    <div class="window__bar">
        <span class="window__dots" aria-hidden="true"></span>
        <span class="window__name">@Site.Value.Name.ToLowerInvariant() — bash</span>
        <span class="window__meta">@_allRepositories.Count @T["Prompt.Stats.Repositories"]</span>
        @* Le bandeau du site ayant disparu, la barre de titre porte le changement de langue :
           les adresses sont par langue (ADR 0006) et il faut pouvoir passer de l'une à
           l'autre autrement qu'en éditant l'URL. *@
        <CultureSelector />
    </div>

    <div class="window__screen">
        @* La bannière tient lieu de titre d'affichage : la peau n'a pas de fonte d'affichage,
           c'est le dessin en caractères qui en fait office. Elle est décorative pour qui
           écoute la page — le titre de niveau 1 juste en dessous porte le texte. *@
        <pre class="cli__banner" role="img" aria-label="@Site.Value.Name">@Banner</pre>

        @* Le titre et l'intro restent, en ligne de commentaire : une page sans <h1> n'est
           pas indexable, et le visiteur a droit à une phrase qui dit où il est. *@
        <h1 class="cli__note">// @T["Home.Title"] — @_allRepositories.Count @T["Prompt.Stats.Repositories"], @_availableLanguages.Count @T["Prompt.Stats.Languages"]</h1>
        <p class="cli__note">// @T["Home.Intro"]</p>
        <p class="cli__boot">@T["Prompt.Boot"]</p>

        @if (_allRepositories.Count == 0)
        {
            <p class="notice notice--warning" role="status">@T["Home.Unavailable"]</p>
        }
        else
        {
            <p class="cli__line" aria-hidden="true">
                <span class="cli__prompt">@Prompt</span> repos @_filter.ToCommandLine()
            </p>

            <p class="results-count" role="status">
                @(Listed.Count == _visibleRepositories.Count
                    ? _visibleRepositories.Count == 1
                        ? T["Home.RepoCountOne"].Value
                        : string.Format(CultureInfo.CurrentCulture, T["Home.RepoCount"].Value, _visibleRepositories.Count)
                    : string.Format(CultureInfo.CurrentCulture, T["Home.RepoCountOf"].Value, Listed.Count, _visibleRepositories.Count))
            </p>

            @if (_visibleRepositories.Count == 0)
            {
                <p class="notice">@T["Home.EmptyFiltered"]</p>
            }
            else
            {
                @* Les en-têtes de colonnes, comme les écrirait un « ls -l ». Décoratifs pour
                   qui écoute la page : chaque ligne porte déjà ses valeurs en toutes lettres. *@
                <p class="listing__head" aria-hidden="true">
                    <span>@T["Repo.Language"]</span>
                    <span>@T["Listing.Pushed"]</span>
                    <span>@T["Repo.Stars"]</span>
                    <span>@T["Listing.Name"]</span>
                </p>

                <ul class="listing">
                    @foreach (var repository in Listed)
                    {
                        <RepositoryRow Repository="repository" />
                    }
                </ul>

                @if (Listed.Count < _visibleRepositories.Count)
                {
                    @* La suite est à un lien, qui fonctionne sans JavaScript et reste une
                       adresse partageable — pas à un bouton qui déplierait la liste. *@
                    <p class="cli__more">
                        @string.Format(CultureInfo.CurrentCulture, T["Home.More"].Value, _visibleRepositories.Count - Listed.Count)
                        <a href="@AllHref">@T["Home.ShowAll"]</a>
                    </p>
                }
            }

            @* Les sorties que le prompt sait afficher sans recharger la page. Elles sont
               rendues ici, traduites et déjà chiffrées : le script client ne connaît ni texte
               ni règle, il ne fait que recopier le bloc demandé (ADR 0008). Ajouter une
               commande, c'est ajouter un bloc — le script n'a pas à le savoir. Sans
               JavaScript, rien de tout ceci ne s'affiche, et rien n'est perdu : ce sont des
               commodités, pas des fonctions du site. *@
            <div class="cli__outputs" hidden="@(_output is null)">
                <div data-output="help" hidden="@Hidden("help")">
                    <pre>@T["Prompt.Help"]</pre>
                </div>

                <div data-output="whoami" hidden="@Hidden("whoami")">
                    <pre>@T["Prompt.WhoAmI"]</pre>
                </div>

                <div data-output="stats" hidden="@Hidden("stats")">
                    <ul class="cli__stats">
                        <li>@T["Prompt.Stats.Repositories"] <span data-stat="repositories">@_allRepositories.Count</span></li>
                        <li>@T["Prompt.Stats.Languages"] <span data-stat="languages">@_availableLanguages.Count</span></li>
                        <li>@T["Prompt.Stats.Stars"] <span data-stat="stars">@_allRepositories.Sum(repository => repository.Stars)</span></li>
                        <li>@T["Prompt.Stats.Demos"] <span data-stat="demos">@_demoCount</span></li>
                        <li>@T["Prompt.Stats.Archived"] <span data-stat="archived">@_archivedCount</span></li>
                    </ul>
                </div>

                @* Les sujets et les langages ne sont plus cliquables au-dessus de la liste :
                   ces deux sorties sont devenues le seul endroit où on les découvre. *@
                <div data-output="topics" hidden="@Hidden("topics")">
                    <ul class="cli__stats">
                        @foreach (var topic in _availableTopics)
                        {
                            <li>@topic.Value <span>@topic.Count</span></li>
                        }
                    </ul>
                </div>

                <div data-output="langs" hidden="@Hidden("langs")">
                    <ul class="cli__stats">
                        @foreach (var language in _availableLanguages)
                        {
                            <li>@language.Value <span>@language.Count</span></li>
                        }
                    </ul>
                </div>

                <div data-output="cache" hidden="@Hidden("cache")">
                    <pre>@T["Prompt.Cache"]</pre>
                </div>

                @* Ce qui suit ne sert à rien, et c'est voulu. *@
                <div data-output="eggs" hidden="@Hidden("eggs")">
                    <ul class="cli__eggs">
                        <li data-egg="sudo">sudo rm -rf / <span>@T["Prompt.Eggs.Sudo"]</span></li>
                        <li data-egg="matrix">matrix <span>@T["Prompt.Eggs.Matrix"]</span></li>
                        <li data-egg="coffee">coffee <span>@T["Prompt.Eggs.Coffee"]</span></li>
                        <li data-egg="vim">vim <span>@T["Prompt.Eggs.Vim"]</span></li>
                        <li data-egg="exit">exit <span>@T["Prompt.Eggs.Exit"]</span></li>
                    </ul>
                </div>

                <div data-output="sudo" hidden="@Hidden("sudo")"><pre>@T["Prompt.Sudo"]</pre></div>
                <div data-output="matrix" data-effect="rain" hidden="@Hidden("matrix")"><pre>@T["Prompt.Matrix"]</pre></div>
                <div data-output="coffee" hidden="@Hidden("coffee")"><pre>@T["Prompt.Coffee"]</pre></div>
                <div data-output="vim" hidden="@Hidden("vim")"><pre>@T["Prompt.Vim"]</pre></div>
                <div data-output="exit" hidden="@Hidden("exit")"><pre>@T["Prompt.Exit"]</pre></div>
            </div>
        }
    </div>

    @* Le prompt est un vrai formulaire GET : il fonctionne sans JavaScript, et une commande
       y mène à la même adresse qu'un clic y aurait menée (ADR 0008). C'est désormais le seul
       chemin vers un filtre, d'où la mention des commandes utiles dans son invite. *@
    <form method="get" class="cli__form" role="search">
        <label class="cli__prompt" for="c">@Prompt</label>
        <input type="text" id="c" name="c" autocomplete="off" spellcheck="false"
               placeholder="@T["Prompt.Placeholder"]" aria-label="@T["Prompt.Label"]" />
        <button type="submit" class="visually-hidden">@T["Filter.Apply"]</button>
    </form>
</div>

@* Les raccourcis n'existent que si le script est là : il retire lui-même l'attribut. Les
   annoncer sans lui serait mentir. *@
<p class="cli__hints" hidden>@T["Prompt.Hints"]</p>

@* Des liens, et non des boutons : ils mènent à la commande par la même adresse que la
   saisie, donc sans JavaScript. C'est aussi ce qui remplace la découverte qu'offrait la
   barre de critères (ADR 0010). *@
<nav class="cli__examples" aria-label="@T["Prompt.Examples"]">
    @foreach (var example in Examples)
    {
        <a class="cli__example" href="@QueryHelpers.AddQueryString(".", "c", example)">@example</a>
    }
</nav>

@code {
    /// <summary>
    /// Le nom du site dessiné en caractères, tel qu'un programme l'écrirait au démarrage.
    /// </summary>
    /// <remarks>
    /// Écrit ici et non dans le balisage : dans un <c>&lt;pre&gt;</c>, l'indentation du
    /// fichier source ferait partie du rendu, et le dessin serait décalé de la marge du
    /// composant.
    /// </remarks>
    private const string Banner = """
 ██████╗ ██████╗  █████╗ ███╗   ██╗ ██████╗ ██╗████████╗
 ██╔══██╗██╔══██╗██╔══██╗████╗  ██║██╔════╝ ██║╚══██╔══╝
 ██║  ██║██████╔╝███████║██╔██╗ ██║██║  ███╗██║   ██║
 ██║  ██║██╔══██╗██╔══██║██║╚██╗██║██║   ██║██║   ██║
 ██████╔╝██║  ██║██║  ██║██║ ╚████║╚██████╔╝██║   ██║
 ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝ ╚═════╝ ╚═╝   ╚═╝
""";

    /// <summary>Invite de commande décorative, répétée avant chaque section.</summary>
    private const string Prompt = "drangoht@~/repos $";

    /// <summary>
    /// Commandes dont la page contient déjà la réponse, et qui n'ont donc rien à demander au
    /// catalogue.
    /// </summary>
    /// <remarks>
    /// Le script client les traite sans recharger la page (ADR 0008). Elles sont répétées ici
    /// pour que le serveur sache les rendre aussi : les critères cliquables ayant disparu
    /// (ADR 0010), « topics » et « langs » sont devenus le seul endroit où l'on découvre les
    /// sujets et les langages — les laisser au JavaScript seul retirerait cette découverte à
    /// qui n'en a pas. Les blocs, eux, ne sont écrits qu'une fois, dans le balisage.
    /// </remarks>
    private static readonly string[] KnownOutputs =
        ["help", "whoami", "stats", "topics", "langs", "cache", "eggs", "sudo", "matrix", "coffee", "vim", "exit"];

    /// <summary>
    /// Commandes proposées sous la fenêtre, pour ne pas laisser le visiteur devant un prompt
    /// vide. Elles couvrent les trois familles : filtrer, s'informer, et perdre son temps.
    /// </summary>
    private static readonly string[] Examples =
        ["help", "ls --demo", "ls --topic=unity", "find huffman", "stats", "topics", "whoami", "eggs"];

    /// <summary>Sortie demandée au prompt, quand la commande en désigne une.</summary>
    private string? _output;

    /// <summary>Masque un bloc de sortie tant que ce n'est pas lui qu'on demande.</summary>
    private bool Hidden(string output) => !string.Equals(_output, output, StringComparison.Ordinal);

    private IReadOnlyList<Repository> _allRepositories = [];
    private IReadOnlyList<Repository> _visibleRepositories = [];
    private IReadOnlyList<RepositoryFacet> _availableTopics = [];
    private IReadOnlyList<RepositoryFacet> _availableLanguages = [];
    private int _demoCount;
    private int _archivedCount;
    private RepositoryFilter _filter = RepositoryFilter.Empty;

    /// <summary>Contexte de la requête en cours, fourni par le rendu serveur statique.</summary>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "topic")]
    private string? Topic { get; set; }

    [SupplyParameterFromQuery(Name = "lang")]
    private string? Language { get; set; }

    [SupplyParameterFromQuery(Name = "demo")]
    private string? Demo { get; set; }

    [SupplyParameterFromQuery(Name = "active")]
    private string? Active { get; set; }

    /// <summary>Ligne saisie au prompt, à interpréter puis à effacer de l'adresse.</summary>
    [SupplyParameterFromQuery(Name = "c")]
    private string? Command { get; set; }

    /// <summary>Écrit la liste en entier plutôt que son début.</summary>
    [SupplyParameterFromQuery(Name = "all")]
    private string? All { get; set; }

    private bool ShowAll => bool.TryParse(All, out var all) && all;

    private bool WithDemoOnly => bool.TryParse(Demo, out var demo) && demo;

    private bool ArchivedHidden => bool.TryParse(Active, out var active) && active;

    /// <summary>
    /// Dépôts listés, celui qui tenait la vitrine en tête.
    /// </summary>
    /// <remarks>
    /// La vitrine a disparu (ADR 0010), pas la désignation : le dépôt que le fichier éditorial
    /// met en avant ouvre la liste. Sous filtre, l'ordre du catalogue prime — un dépôt hors
    /// critère s'inviterait en tête des résultats.
    /// </remarks>
    private IReadOnlyList<Repository> Listed =>
        RepositoryListing.FirstPageOf(Ordered, ShowAll ? 0 : RepositoryListing.DefaultPageSize);

    /// <summary>Dépôts visibles, celui que le fichier éditorial désigne en tête.</summary>
    private IReadOnlyList<Repository> Ordered =>
        !_filter.IsActive && FeaturedRepository.Of(_visibleRepositories) is { } featured
            ? [featured, .. _visibleRepositories.Where(repository => repository != featured)]
            : _visibleRepositories;

    /// <summary>Adresse de la même liste, écrite en entier.</summary>
    private string AllHref => QueryHelpers.AddQueryString(PathOf(_filter), "all", "true");

    protected override async Task OnParametersSetAsync()
    {
        _allRepositories = await Catalog.GetRepositoriesAsync(HttpContext?.RequestAborted ?? CancellationToken.None);
        _availableTopics = RepositoryFilter.AvailableTopicsOf(_allRepositories);
        _availableLanguages = RepositoryFilter.AvailableLanguagesOf(_allRepositories);
        _demoCount = RepositoryFilter.CountWithDemo(_allRepositories);
        _archivedCount = RepositoryFilter.CountArchived(_allRepositories);

        // Une commande saisie ne reste jamais dans l'adresse : elle est traduite en la même
        // adresse qu'aurait produite un clic, puis on y redirige. Sans quoi « ?c=… » et
        // « ?topic=… » seraient deux adresses pour la même page, partagées au hasard.
        if (Command is not null)
        {
            // Une commande dont la réponse est déjà dans la page s'affiche sur place : elle
            // ne mène nulle part, et rediriger vers une adresse inventée pour elle ferait
            // d'une commodité une page à indexer.
            _output = KnownOutputs.FirstOrDefault(
                output => string.Equals(output, Command.Trim().ToLowerInvariant(), StringComparison.Ordinal));

            if (_output is null)
            {
                Navigation.NavigateTo(PathOf(RepositoryCommand.Parse(Command, _allRepositories)));
                return;
            }
        }

        _filter = new RepositoryFilter
        {
            SearchTerm = Search,
            Topic = Topic,
            Language = Language,
            WithDemo = WithDemoOnly,
            HideArchived = ArchivedHidden,
        };

        _visibleRepositories = _filter.Apply(_allRepositories);
    }

    /// <summary>Adresse relative où mène une commande, préfixe de langue compris par la base.</summary>
    private static string PathOf(RepositoryCommand command) => command switch
    {
        RepositoryCommand.Open open => "repos/" + open.Slug.Value,
        RepositoryCommand.GoToPage { Page: SitePage.About } => "about",
        RepositoryCommand.Filter filter => PathOf(filter.Value),
        _ => ".",
    };

    /// <summary>Adresse d'une liste filtrée : celle-là même que produisent les liens de la barre.</summary>
    private static string PathOf(RepositoryFilter filter)
    {
        var query = new Dictionary<string, string?>(StringComparer.Ordinal);

        AddIfSet(query, "q", filter.SearchTerm);
        AddIfSet(query, "topic", filter.Topic);
        AddIfSet(query, "lang", filter.Language);

        if (filter.WithDemo)
        {
            query["demo"] = "true";
        }

        if (filter.HideArchived)
        {
            query["active"] = "true";
        }

        return QueryHelpers.AddQueryString(".", query);
    }

    private static void AddIfSet(Dictionary<string, string?> query, string name, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            query[name] = value;
        }
    }
}
