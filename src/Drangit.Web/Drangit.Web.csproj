<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>0c7a1f3e-5d64-4f5a-9a2b-7c1f9d3e8b41</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="15.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contenu éditorial : copie dans la sortie, donc dans l'image Docker. -->
    <Content Update="data\repositories.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Drangit.Tests" />
  </ItemGroup>

</Project>
